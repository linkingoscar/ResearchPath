{
  "schemaVersion": "2.0.0",
  "name": "ResearchPath",
  "architecture": "local-first-modular-monolith",
  "productScope": {
    "core": [
      "data import and variable identification",
      "project-versioned study context and dataset-bound structural role mapping",
      "questionnaire measurement and empirical indicators",
      "cross-sectional clustered-data aggregation diagnostics and two-level Gaussian LMM",
      "observed and latent CLPM/RI-CLPM/LCM-SR with longitudinal invariance, ULMC sensitivity and power",
      "daily-diary/ESM LMM and binary/count/zero-inflated/Hurdle GLMM with crossed effects, explicit centering/time protocols, observed-variable Bayesian DSEM with modern diagnostics, multilevel mediation, MI and power",
      "randomized factorial ANOVA, ANCOVA, repeated-measures, mixed-design and cluster-robust experimental analysis; no quasi-experimental causal identification",
      "general regression, t-test and ANOVA power, precision, MDES and Monte Carlo analysis",
      "general type-aware MICE with Rubin pooled linear inference",
      "advanced questionnaire measurement with declared-target ESEM, continuous/ordinal bifactor, binary 2PL and ordinal GRM IRT/DIF",
      "visual PROCESS-equivalent model building",
      "R-backed OLS/logistic/SEM execution",
      "structured results and reproducible exports"
    ],
    "deferred": [
      "research-program and preregistration workspace",
      "autonomous multi-source statistical certification",
      "quasi-experimental causal identification (fixed effects, DiD/event study, IV, RDD, IPW and synthetic control)"
    ]
  },
